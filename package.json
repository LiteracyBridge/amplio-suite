{
  "name": "amplio-suite",
  "version": "0.1.1",
  "private": true,
  "scripts": {
    "test:unit": "vue-cli-service test:unit",
    "serve": "vue-tsc --noEmit && vite",
    "vite": "vite",
    "build:staging": "vue-tsc --noEmit && vite build --mode staging",
    "build:preview": "vue-tsc --noEmit && vite build --mode production && vite preview",
    "build:production": "vue-tsc --noEmit && vite build --mode production",
    "preview": "npm run build && vite preview --port 4173",
    "cypress": "cypress",
    "format": "prettier --write \"{src,apps,libs,test,vue}/**/*.ts\" \"test/**/*.ts\"",
    "deploy:testing": "docker build --tag test-suite --build-arg PORT=6001 --build-arg NODE_ENV=testing . && docker run --publish 127.0.0.1:6001:6001 --restart always --detach test-suite",
    "deploy:prod": "docker build --tag prod-suite --build-arg PORT=5001 . && docker run --publish 127.0.0.1:5001:5001 --restart always --detach prod-suite"
  },
  "dependencies": {
    "@ant-design/icons-vue": "^7.0.1",
    "@aws-amplify/ui-vue": "^4.2.10",
    "@fortawesome/fontawesome-svg-core": "^6.6.0",
    "@fortawesome/free-brands-svg-icons": "^6.6.0",
    "@fortawesome/free-solid-svg-icons": "^6.6.0",
    "@fortawesome/vue-fontawesome": "^3.0.8",
    "@typescript-eslint/eslint-plugin": "^8.0.1",
    "ant-design-vue": "^4.2.6",
    "aws-amplify": "^6.5.0",
    "axios": "^1.7.3",
    "chart.js": "^4.5.1",
    "chartjs-plugin-datalabels": "^2.2.0",
    "exceljs": "^4.4.0",
    "lodash": "^4.17.21",
    "luxon": "^3.5.0",
    "ol": "^10.3.1",
    "papaparse": "^5.4.1",
    "pinia": "^2.2.1",
    "portal-vue": "^3.0.0",
    "read-excel-file": "^5.8.6",
    "tailwindcss": "^3.4.8",
    "vue": "^3.5.28",
    "vue-chartjs": "^5.3.1",
    "vue-multiselect": "^3.0.0",
    "vue-request": "^2.0.4",
    "vue-router": "^4.4.3",
    "vue-router-multiguard": "^1.0.3",
    "vuedraggable": "^4.1.0"
  },
  "devDependencies": {
    "@types/lodash": "^4.17.7",
    "@types/luxon": "^3.4.2",
    "@types/node": "22",
    "@vitejs/plugin-vue": "^5.1.2",
    "@vue/cli-plugin-babel": "~5.0.8",
    "@vue/cli-plugin-router": "~5.0.8",
    "@vue/cli-plugin-unit-jest": "^5.0.8",
    "@vue/cli-plugin-vuex": "~5.0.8",
    "@vue/cli-service": "~5.0.8",
    "@vue/compiler-sfc": "^3.4.36",
    "@vue/tsconfig": "^0.5.1",
    "axe-core": "^4.10.0",
    "cypress": "^13.13.2",
    "sass": "^1.77.8",
    "sass-loader": "^16.0.0",
    "typescript": "^5.5.4",
    "vite": "^6.0.9",
    "vite-svg-loader": "^5.1.0",
    "vue-axe": "^3.1.2",
    "vue-tsc": "^2.0.29"
  }
}
