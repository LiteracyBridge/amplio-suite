{
  "name": "amplio-suite",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "test:unit": "vue-cli-service test:unit",
    "serve": "vue-tsc --noEmit && vite",
    "vite": "vite",
    "staging-build": "vue-tsc --noEmit && vite build --mode staging",
    "build:preview": "vue-tsc --noEmit && vite build --mode production && vite preview",
    "production-build": "vue-tsc --noEmit && vite build --mode production",
    "preview": "npm run build && vite preview --port 4173",
    "cypress": "cypress",
    "format": "prettier --write \"{src,apps,libs,test,vue}/**/*.ts\" \"test/**/*.ts\"",
    "lint": "npm run format && eslint \"{src,apps,libs,test,vue}/**/*.ts\" --fix"
  },
  "dependencies": {
    "@ant-design/icons-vue": "^7.0.1",
    "@aws-amplify/ui-vue": "^3.1.29",
    "@fortawesome/fontawesome-svg-core": "^6.4.2",
    "@fortawesome/free-brands-svg-icons": "^5.13.0",
    "@fortawesome/free-solid-svg-icons": "^5.13.0",
    "@fortawesome/vue-fontawesome": "^3.0.3",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "ant-design-vue": "^4.1.1",
    "aws-amplify": "^5.3.11",
    "axios": "^0.19.2",
    "chart.js": "^4.4.1",
    "eslint-plugin-unused-imports": "^3.0.0",
    "exceljs": "^4.4.0",
    "lodash": "^4.17.21",
    "luxon": "^3.4.4",
    "papaparse": "^5.4.1",
    "pinia": "^2.1.7",
    "portal-vue": "^3.0.0",
    "tailwindcss": "^1.4.5",
    "vue": "^3.1.0",
    "vue-chartjs": "^5.3.0",
    "vue-multiselect": "^3.0.0-beta.2",
    "vue-request": "^2.0.4",
    "vue-router": "^4.2.4",
    "vue-router-multiguard": "^1.0.3",
    "vuedraggable": "^4.1.0"
  },
  "devDependencies": {
    "@types/lodash": "^4.14.202",
    "@types/luxon": "^3.4.2",
    "@types/node": "20",
    "@vitejs/plugin-vue": "^4.4.0",
    "@vue/cli-plugin-babel": "~4.3.0",
    "@vue/cli-plugin-eslint": "~4.3.0",
    "@vue/cli-plugin-router": "~4.3.0",
    "@vue/cli-plugin-unit-jest": "^4.3.1",
    "@vue/cli-plugin-vuex": "~4.3.0",
    "@vue/cli-service": "~4.3.0",
    "@vue/compiler-sfc": "^3.1.0",
    "@vue/eslint-config-prettier": "^6.0.0",
    "@vue/tsconfig": "^0.4.0",
    "axe-core": "^4.8.2",
    "babel-eslint": "^10.1.0",
    "cypress": "^13.6.2",
    "eslint": "^8.56.0",
    "eslint-plugin-prettier": "^3.1.1",
    "eslint-plugin-vue": "^9.21.1",
    "prettier-eslint": "^16.3.0",
    "prettier": "^3.2.5",
    "sass": "^1.49.7",
    "sass-loader": "^8.0.2",
    "typescript": "^5.2.2",
    "vite": "4.1.4",
    "vite-svg-loader": "^4.0.0",
    "vue-axe": "^3.1.2",
    "vue-loader": "^16.0.0",
    "vue-svg-loader": "^0.16.0",
    "vue-tsc": "^1.8.14"
